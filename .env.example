# Database configuration
# Options: sqlite (default), postgres
DB_TYPE=sqlite

# PostgreSQL connection (only used when DB_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=skeleton
POSTGRES_PASSWORD=skeleton_dev
POSTGRES_DB=skeleton_dev

# Authentication mode
# Options: mock (default for dev), cognito (production)
AUTH_MODE=mock

# HTTPS (set to false to disable HTTPS in dev)
USE_HTTPS=true
