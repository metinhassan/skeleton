{
  "name": "skeleton-app",
  "version": "1.0.0",
  "description": "Skeleton TypeScript app with login functionality",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:server\"",
    "dev:vite": "vite --port 5173",
    "dev:server": "tsx server/dev-server.ts",
    "build": "npm run build:authlib && tsc && vite build",
    "build:authlib": "npm run --prefix src/authlib build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "setup:certs": "mkcert -install && mkdir -p certs && mkcert -cert-file certs/localhost.pem -key-file certs/localhost-key.pem localhost 127.0.0.1",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:seed": "docker compose exec -T postgres psql -U skeleton -d skeleton_dev -f /docker-entrypoint-initdb.d/seed.sql",
    "db:logs": "docker compose logs -f postgres",
    "dev:postgres": "DB_TYPE=postgres npm run dev",
    "test:api": "./scripts/test-api.sh"
  },
  "keywords": [
    "typescript",
    "login",
    "skeleton"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@authlib/core": "file:src/authlib/packages/auth-core",
    "@authlib/mock": "file:src/authlib/packages/auth-mock",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.0.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.16.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^1.1.0",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.0",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}
